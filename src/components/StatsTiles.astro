<section class="section-metrics" id="metrics" aria-labelledby="metrics-h2">
  <div class="container">
    <h2 id="metrics-h2" class="fade-in-el">By the numbers</h2>
    <div class="metrics-strip fade-in-el" role="list">
      <div class="metric" role="listitem">
        <span class="metric-number">11+ yrs</span>
        <span class="metric-label">Building distributed backends</span>
        <span class="metric-sub">Media &middot; fintech &middot; food-tech &middot; travel</span>
      </div>
      <div class="metric" role="listitem">
        <span class="metric-number">~50%</span>
        <span class="metric-label">Latency reduction</span>
        <span class="metric-sub">Swiggy Dineout (formerly Dineout, Times Internet) &mdash; POS event pipelines</span>
      </div>
      <div class="metric" role="listitem">
        <span class="metric-number">95%</span>
        <span class="metric-label">Credit workflow automation</span>
        <span class="metric-sub">PT Tujuh Asia &mdash; P2P lending platform</span>
      </div>
      <div class="metric" role="listitem">
        <span class="metric-number">6+</span>
        <span class="metric-label">Microservices orchestrated for GDPR/CCPA fan-out</span>
        <span class="metric-sub">At Warner Bros. Discovery via OneTrust</span>
      </div>
    </div>
    <div class="c-chips fade-in-el" aria-label="Scale and compliance highlights">
      <span class="c-chip">GDPR / CCPA via OneTrust</span>
      <span class="c-chip">Multi-brand moderation in-house</span>
      <span class="c-chip">Kafka in production at scale</span>
      <span class="c-chip">10+ POS systems integrated</span>
    </div>
  </div>
</section>
